# ── void-node-agent ──────────────────────────────────────────────────────────
# Токен для /block /unblock и т.д. Сгенерировать: openssl rand -hex 32
AGENT_TOKEN=

# Порт и адрес агента
AGENT_PORT=8765
AGENT_HOST=0.0.0.0

# Имя ноды (уникальное!)
NODE_NAME=fi-node-1

# Центральный бот: URL + общий секрет регистрации (тот же, что
# NODE_REGISTRATION_SECRET в .env бота). Сгенерировать: openssl rand -hex 32
CENTRAL_API_URL=https://netvoid.ru
REGISTRATION_SECRET=

# (опц.) Явный публичный URL агента. Если пусто — внешний IP определится сам.
#AGENT_PUBLIC_URL=http://1.2.3.4:8765

# (опц.) TTL блокировки по умолчанию в часах, 0 = бессрочно
DEFAULT_TTL_HOURS=24

# (опц.) IP, которые нельзя блокировать никогда (через запятую) — IP бота/панели.
# Впиши СВОИ адреса. Если ставишь через install.sh с ALLOW_IPS — можно не трогать.
#NEVER_BLOCK=1.2.3.4,5.6.7.8

# (опц.) Период heartbeat-регистрации, минуты
REGISTER_INTERVAL_MIN=10

# (опц.) Имя ipset-набора. Если в системе есть ipset — агент использует его
# автоматически (быстрее на масштабе). Иначе фолбэк на обычный iptables.
#IPSET_NAME=void-block
