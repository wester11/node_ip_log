# VOID Node Agent v2. Normally install.sh creates this file automatically.
CENTRAL_API_URL=https://netvoid.ru
NODE_NAME=fi-node-1
AGENT_HOST=127.0.0.1
AGENT_PORT=8765
# Local loopback API only. The central management token is stored separately
# in /var/lib/void-node-agent/identity.json and never belongs in this file.
AGENT_TOKEN=
DEFAULT_TTL_HOURS=24
NEVER_BLOCK=
IPSET_NAME=void-block
